---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import '../styles/sprites.css';
---
<Base title="Page not found · KazooKat" description="This page doesn't exist on KazooKat's portfolio. The desk has links to every project.">
  <Header />
  <main class="lost">
    <div class="scene" aria-hidden="true">
      <div class="spr me"></div>
      <div class="sign px">404</div>
    </div>
    <div class="shelf" aria-hidden="true"></div>
    <h1 class="px">Page not found</h1>
    <p>There's nothing on the desk at this address.</p>
    <a class="home px" href="/">Back to the desk</a>
  </main>
</Base>

<style>
  .lost { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 48px 16px; text-align: center; }
  .scene { display: flex; align-items: flex-end; gap: calc(var(--u) * 4); margin-bottom: -10px; }
  .sign { padding: 10px 18px; font-size: 32px; font-weight: 700; background: var(--card); border: 4px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); margin-bottom: calc(var(--u) * 4); }
  .shelf { width: min(420px, 90vw); height: calc(var(--u) * 5); background: linear-gradient(var(--wood-hi) 0 var(--u), var(--wood) var(--u) calc(100% - var(--u)), var(--wood-sh) calc(100% - var(--u))); border-top: var(--u) solid var(--ink); border-bottom: var(--u) solid var(--ink); border-radius: var(--u); }
  h1 { margin: 18px 0 0; font-size: 40px; }
  p { margin: 0; color: var(--muted); }
  .home { margin-top: 12px; font-weight: 700; padding: 6px 14px; background: var(--accent-ink); color: var(--card); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); text-decoration: none; }
</style>
