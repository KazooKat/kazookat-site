---
import '../styles/tokens.css';
import build from '../build-id.json';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="build" content={build.id} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <a href="https://github.com/KazooKat">GitHub</a>
      <a href="mailto:contact@kazookat.dev">contact@kazookat.dev</a>
      <a href="https://sss.1m3.jp/">Skin render: SkinSprite Studio</a>
    </footer>
  </body>
</html>
